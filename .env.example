# ============================================================
# SmartCart Environment Variables Configuration Example
# ============================================================

# Flask Secret Key for Session Signing
SECRET_KEY=smartcart-ai-recommendation-secret-key-2026

# Force SQLite mode (true/false)
USE_SQLITE=false

# Full SQLAlchemy Database URI (optional override)
# e.g.: mysql+pymysql://root:password@localhost:3306/smartcart_db
# or:   sqlite:///d:/projects/SMARTCART/smartcart.db
DATABASE_URL=

# MySQL Database Connection Parameters (used when DATABASE_URL is not set)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=smartcart_db
